# Environment variables for the server (Vercel Functions).
# Enter these in Vercel: Project -> Settings -> Environment Variables. Never commit real values.

# Supabase -> Connect -> Connection String -> "Transaction pooler" (host ...pooler.supabase.com, port 6543),
# with your database password filled in. The "Direct connection" (db.<ref>.supabase.co) does not work here.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Supabase -> Project Settings -> API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...            # "anon public" key, safe to show in the browser
SUPABASE_SERVICE_ROLE_KEY=eyJ...    # "service_role" key, secret: server only

# Gmail of the project: 2-Step Verification on, then myaccount.google.com/apppasswords
GMAIL_USER=tryyourpet.project@gmail.com
GMAIL_APP_PASSWORD=abcdabcdabcdabcd

# Where "new order / new support" notices go (defaults to GMAIL_USER)
NOTIFY_EMAIL=

# Any long random string (40+ characters); signs the email-verification tokens
TOKEN_SECRET=

# Any long random string; Vercel Cron sends it so only Vercel can trigger the daily clean-up
CRON_SECRET=

# Optional: the public address used in email footers, e.g. https://tryyourpet.vercel.app
SITE_URL=
