# Environment variables for the server (Netlify Functions).
# Enter these in Netlify: Project configuration -> Environment variables. Never commit real values.

# Supabase -> Project Settings -> Database -> Connection string -> URI, "Transaction pooler" (port 6543),
# with your database password filled in.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Supabase -> Project Settings -> API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...            # "anon public" key, safe to show in the browser
SUPABASE_SERVICE_ROLE_KEY=eyJ...    # "service_role" key, secret: server only

# Gmail of the project: 2-Step Verification on, then myaccount.google.com/apppasswords
GMAIL_USER=tryyourpet.project@gmail.com
GMAIL_APP_PASSWORD=abcdabcdabcdabcd

# Where "new order / new support" notices go (defaults to GMAIL_USER)
NOTIFY_EMAIL=

# Any long random string (40+ characters); signs the email-verification tokens
TOKEN_SECRET=
